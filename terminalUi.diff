+// ---------- session storage ----------
+// The linked WhatsApp session lives in a folder. SESSION_DIR can point it at a persistent disk/volume
+// (for hosts that wipe the project folder on every deploy). Default: ./session
+const MENU_TIMEOUT_MS = parseInt(process.env.MENU_TIMEOUT_MS, 10) || 45000;
+
+function getSessionDir() {
+    const custom = (process.env.SESSION_DIR || '').trim();
+    return custom ? path.resolve(custom) : path.join(__dirname, '..', 'session');
+}
+
+function clearSavedSession() {
+    try { fs.emptyDirSync(getSessionDir()); } catch (e) {}
+}
+
+// Is a linked session saved, and for which number? (number is null when WhatsApp stored a LID instead)
+function readSavedSession(dir) {
+    try {
+        const creds = fs.readJsonSync(path.join(dir, 'creds.json'));
+        const id = creds && creds.me && creds.me.id;
+        if (!id) return { registered: false, number: null };
+        const [user, domain] = String(id).split('@');
+        return { registered: true, number: domain === 's.whatsapp.net' ? user.split(':')[0] : null };
+    } catch (e) {
+        return { registered: false, number: null };
+    }
+}
